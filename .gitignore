# ── Large external trees (do NOT commit) ──────────────────────────────
# ns3ai-venv = 6.1G Python virtualenv
ns3ai-venv/
# ns-3-dev = 3.7G ns-3 checkout; custom scenarios mirrored in ns3_scenarios/
ns-3-dev/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Trained models / RL checkpoints (regenerated by train scripts) ────────
*.zip
results/ppo_gnn_routing_agent/
results/ppo_gnn_routing_agent_*/
results/models/
results/ppo_logs_*/
# SB3 policy saves (some lack a .zip extension)
results/**/gnn_scale*
results/**/gnn_generalist*

# ── Logs & scratch outputs ────────────────────────────────────────────
*.log
*.tmp
*.out

# ── OS / editor cruft ─────────────────────────────────────────────────
.DS_Store
*.swp
